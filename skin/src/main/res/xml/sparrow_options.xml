<?xml version="1.0" encoding="utf-8"?>
<!-- Options shared by every Sparrow skin (included from skins.xml), grouped into pages that follow the player screen from
     top to bottom. Most options switch on Poweramp's own overlay styles, so they stay correct across Poweramp updates.
     defaultValue holds the overlap value of the option that is on by default.

     Order matters: Poweramp applies the options in document order (pages included), and these pairs write the same
     attributes, so the first must stay before the second (checked against Poweramp's resources):
     - layout before track info alignment/background, buttons on cover, more button, quick buttons, seekbar, seekbar
       position, control size and extra skip buttons
     - track info alignment before buttons on cover and more button; buttons on cover before more button
     - seekbar before seekbar position, time backgrounds, control size and extra skip buttons
     - accent before nav bar (the glass icon colors win)
     - font before dot-matrix font
     Keys and option values are what Poweramp saves, so keep them when moving options around.
     Font, progress bar style and volume style default to "Match the look", so each look (values/sparrow_looks.xml) can
     pick its own; a choice the user saved still wins. -->
<category name="@string/opt_cat_customize">

	<page
		name="@string/page_colors"
		summary="@string/page_colors_summary"
		icon="@drawable/sparrow_page_colors"
		iconTint="default"
	>
		<radio
			key="background"
			name="@string/opt_background"
			defaultValue="@style/Sparrow_Option_BgColor"
		>
			<option
				name="@string/opt_bg_blur"
				summary="@string/opt_bg_blur_summary"
				overlapStyle=""
			/>
			<option
				name="@string/opt_bg_color"
				summary="@string/opt_bg_color_summary"
				overlapStyle="@style/Sparrow_Option_BgColor"
			/>
			<option
				name="@string/opt_bg_vivid"
				summary="@string/opt_bg_vivid_summary"
				overlapStyle="@style/Sparrow_Option_BgVivid"
			/>
			<option
				name="@string/opt_bg_muted"
				summary="@string/opt_bg_muted_summary"
				overlapStyle="@style/Sparrow_Option_BgMuted"
			/>
		</radio>

		<!-- Android 12+ only: the wallpaper palette doesn't exist before that -->
		<multiSwitch
			key="accent"
			name="@string/opt_accent"
			summary="@string/opt_accent_summary"
			minSdk="31"
			defaultValue="@style/Sparrow_Option_Accent"
		>
			<option
				name="@string/opt_off"
				overlapStyle=""
			/>
			<option
				name="@string/opt_accent_wallpaper"
				overlapStyle="@style/Sparrow_Option_Accent"
			/>
		</multiSwitch>
	</page>

	<page
		name="@string/page_cover"
		summary="@string/page_cover_summary"
		icon="@drawable/sparrow_page_cover"
		iconTint="default"
	>
		<radio
			key="layout"
			name="@string/opt_layout"
			defaultValue="@com.maxmpz.audioplayer:attr/overlap_alt_layout"
		>
			<option
				name="@string/opt_layout_clean"
				summary="@string/opt_layout_clean_summary"
				overlapAttr="@com.maxmpz.audioplayer:attr/overlap_alt_layout"
			/>
			<option
				name="@string/opt_layout_full"
				summary="@string/opt_layout_full_summary"
				overlapAttr="@com.maxmpz.audioplayer:attr/overlap_alt_layout2"
			/>
		</radio>

		<multiSwitch
			key="track_labels_align"
			name="@string/opt_labels_align"
			defaultValue=""
		>
			<option
				name="@string/opt_left"
				overlapAttr=""
			/>
			<option
				name="@string/opt_centered"
				overlapAttr="@com.maxmpz.audioplayer:attr/overlap_track_labels_centered"
			/>
		</multiSwitch>

		<multiSwitch
			key="labels_bg"
			name="@string/opt_labels_bg"
			defaultValue="@com.maxmpz.audioplayer:attr/overlap_track_labels_no_bg"
		>
			<option
				name="@string/opt_shown"
				overlapAttr=""
			/>
			<option
				name="@string/opt_hidden"
				overlapAttr="@com.maxmpz.audioplayer:attr/overlap_track_labels_no_bg"
			/>
		</multiSwitch>

		<!-- Buttons over the cover. After the layout option so it overrides the styles that option sets. -->
		<multiSwitch
			key="cover_buttons"
			name="@string/opt_cover_buttons"
			summary="@string/opt_cover_buttons_summary"
			defaultValue="@style/Sparrow_Option_NoCoverButtons"
		>
			<option
				name="@string/opt_shown"
				overlapStyle=""
			/>
			<option
				name="@string/opt_hidden"
				overlapStyle="@style/Sparrow_Option_NoCoverButtons"
			/>
		</multiSwitch>

		<!-- After "Buttons on cover" so it can bring the menu button back next to the title -->
		<multiSwitch
			key="more_button"
			name="@string/opt_more_button"
			summary="@string/opt_more_button_summary"
			defaultValue="@style/Sparrow_Option_MoreByTitle"
		>
			<option
				name="@string/opt_hidden"
				overlapStyle=""
			/>
			<option
				name="@string/opt_by_title"
				overlapStyle="@style/Sparrow_Option_MoreByTitle"
			/>
		</multiSwitch>

		<multiSwitch
			key="quick_buttons"
			name="@string/opt_quick_buttons"
			summary="@string/opt_quick_buttons_summary"
			defaultValue="@style/Sparrow_Option_NoQuickButtons"
		>
			<option
				name="@string/opt_shown"
				overlapStyle=""
			/>
			<option
				name="@string/opt_hidden"
				overlapStyle="@style/Sparrow_Option_NoQuickButtons"
			/>
		</multiSwitch>
	</page>

	<page
		name="@string/page_progress"
		summary="@string/page_progress_summary"
		icon="@drawable/sparrow_page_progress"
		iconTint="default"
	>
		<!-- Wave and Static reset the styles that the Plain-seekbar-only options point at -->
		<multiSwitch
			key="seekbar"
			name="@string/opt_seekbar"
			defaultValue="@com.maxmpz.audioplayer:attr/overlap_plain_seekbar"
		>
			<option
				name="@string/opt_seekbar_wave"
				overlapStyle="@style/Sparrow_Seekbar_Wave"
			/>
			<option
				name="@string/opt_seekbar_static"
				overlapStyle="@style/Sparrow_Seekbar_Static"
			/>
			<option
				name="@string/opt_seekbar_plain"
				overlapAttr="@com.maxmpz.audioplayer:attr/overlap_plain_seekbar"
			/>
		</multiSwitch>

		<msg
			smallLine1="@string/msg_plain_only"
		/>

		<!-- Match the look: no overlay, so the look's theme decides PlainSeekbar -->
		<radio
			key="progress_style"
			name="@string/opt_style"
			defaultValue=""
		>
			<option
				name="@string/opt_match_look"
				summary="@string/opt_match_look_summary"
				overlapStyle=""
			/>
			<option
				name="@string/opt_style_wave"
				summary="@string/opt_progress_wave_summary"
				overlapStyle="@style/Sparrow_Option_ProgressWave"
				icon="@drawable/sparrow_opt_progress_wave"
			/>
			<option
				name="@string/opt_style_line"
				summary="@string/opt_progress_line_summary"
				overlapStyle="@style/Sparrow_Option_ProgressLine"
				icon="@drawable/sparrow_opt_progress_line"
			/>
			<option
				name="@string/opt_style_pill"
				summary="@string/opt_progress_pill_summary"
				overlapStyle="@style/Sparrow_Option_ProgressPill"
				icon="@drawable/sparrow_opt_progress_pill"
			/>
			<option
				name="@string/opt_style_expressive"
				summary="@string/opt_progress_expressive_summary"
				overlapStyle="@style/Sparrow_Option_ProgressExpressive"
				icon="@drawable/sparrow_opt_progress_expressive"
			/>
			<option
				name="@string/opt_style_glow"
				summary="@string/opt_progress_glow_summary"
				overlapStyle="@style/Sparrow_Option_ProgressGlow"
				icon="@drawable/sparrow_opt_progress_glow"
			/>
		</radio>

		<multiSwitch
			key="seekbar_position"
			name="@string/opt_seekbar_position"
			defaultValue="@style/Sparrow_Option_SeekbarTop"
		>
			<option
				name="@string/opt_bottom"
				overlapStyle=""
			/>
			<option
				name="@string/opt_under_track_info"
				overlapStyle="@style/Sparrow_Option_SeekbarTop"
			/>
		</multiSwitch>

		<multiSwitch
			key="time_bg"
			name="@string/opt_time_bg"
			defaultValue="@style/Sparrow_Option_BareTimes"
		>
			<option
				name="@string/opt_shown"
				overlapStyle=""
			/>
			<option
				name="@string/opt_hidden"
				overlapStyle="@style/Sparrow_Option_BareTimes"
			/>
		</multiSwitch>
	</page>

	<!-- After the progress bar page: these override the button styles that the seekbar option sets -->
	<page
		name="@string/page_controls"
		summary="@string/page_controls_summary"
		icon="@drawable/sparrow_page_controls"
		iconTint="default"
	>
		<multiSwitch
			key="control_size"
			name="@string/opt_control_size"
			summary="@string/opt_plain_only_summary"
			defaultValue="@style/Sparrow_Option_LargeControls"
		>
			<option
				name="@string/opt_normal"
				overlapStyle=""
			/>
			<option
				name="@string/opt_large"
				overlapStyle="@style/Sparrow_Option_LargeControls"
			/>
		</multiSwitch>

		<multiSwitch
			key="player_buttons_bg"
			name="@string/opt_buttons_bg"
			summary="@string/opt_buttons_bg_summary"
			defaultValue="@com.maxmpz.audioplayer:attr/overlap_player_buttons_no_bg"
		>
			<!-- Sparrow's icons fill their buttons, so Shown swaps in versions drawn inside a circle -->
			<option
				name="@string/opt_shown"
				overlapStyle="@style/Sparrow_Option_ButtonCircles"
			/>
			<option
				name="@string/opt_hidden"
				overlapAttr="@com.maxmpz.audioplayer:attr/overlap_player_buttons_no_bg"
			/>
		</multiSwitch>

		<multiSwitch
			key="category_buttons"
			name="@string/opt_category_buttons"
			summary="@string/opt_category_buttons_summary"
			defaultValue="@style/Sparrow_Option_NoCategoryButtons"
		>
			<option
				name="@string/opt_shown"
				overlapStyle=""
			/>
			<option
				name="@string/opt_hidden"
				overlapStyle="@style/Sparrow_Option_NoCategoryButtons"
			/>
		</multiSwitch>
	</page>

	<page
		name="@string/page_volume"
		summary="@string/page_volume_summary"
		icon="@drawable/sparrow_page_volume"
		iconTint="default"
	>
		<multiSwitch
			key="volume_slider"
			name="@string/opt_volume_slider"
			defaultValue="@style/Sparrow_Option_Volume"
		>
			<option
				name="@string/opt_hidden"
				overlapStyle=""
			/>
			<option
				name="@string/opt_shown"
				overlapStyle="@style/Sparrow_Option_Volume"
			/>
		</multiSwitch>

		<!-- Match the look: no overlay, so the look's theme decides sparrowVolumeSlider -->
		<radio
			key="volume_style"
			name="@string/opt_style"
			defaultValue=""
		>
			<option
				name="@string/opt_match_look"
				summary="@string/opt_match_look_summary"
				overlapStyle=""
			/>
			<option
				name="@string/opt_style_minimal"
				summary="@string/opt_volume_minimal_summary"
				overlapStyle="@style/Sparrow_Option_VolumeMinimal"
				icon="@drawable/sparrow_opt_volume_minimal"
			/>
			<option
				name="@string/opt_style_line"
				summary="@string/opt_volume_line_summary"
				overlapStyle="@style/Sparrow_Option_VolumeLine"
				icon="@drawable/sparrow_opt_volume_line"
			/>
			<option
				name="@string/opt_style_pill"
				summary="@string/opt_volume_pill_summary"
				overlapStyle="@style/Sparrow_Option_VolumePill"
				icon="@drawable/sparrow_opt_volume_pill"
			/>
			<option
				name="@string/opt_style_expressive"
				summary="@string/opt_volume_expressive_summary"
				overlapStyle="@style/Sparrow_Option_VolumeExpressive"
				icon="@drawable/sparrow_opt_volume_expressive"
			/>
			<option
				name="@string/opt_style_glow"
				summary="@string/opt_volume_glow_summary"
				overlapStyle="@style/Sparrow_Option_VolumeGlow"
				icon="@drawable/sparrow_opt_volume_glow"
			/>
		</radio>
	</page>

	<!-- After the colors page: the glass nav bar's icon colors override the accent's -->
	<page
		name="@string/page_navbar"
		summary="@string/page_navbar_summary"
		icon="@drawable/sparrow_page_navbar"
		iconTint="default"
	>
		<multiSwitch
			key="navbar_style"
			name="@string/opt_navbar_style"
			summary="@string/opt_navbar_style_summary"
			defaultValue="@style/Sparrow_Option_GlassNavbar"
		>
			<option
				name="@string/opt_navbar_solid"
				overlapStyle=""
			/>
			<option
				name="@string/opt_navbar_glass"
				overlapStyle="@style/Sparrow_Option_GlassNavbar"
			/>
		</multiSwitch>

		<multiSwitch
			key="icon_style"
			name="@string/opt_icon_style"
			summary="@string/opt_icon_style_summary"
			defaultValue="@style/Sparrow_Option_PhosphorIcons"
		>
			<option
				name="@string/opt_icons_poweramp"
				overlapStyle=""
			/>
			<option
				name="@string/opt_icons_phosphor"
				overlapStyle="@style/Sparrow_Option_PhosphorIcons"
			/>
		</multiSwitch>
	</page>

	<page
		name="@string/page_fonts"
		summary="@string/page_fonts_summary"
		icon="@drawable/sparrow_page_fonts"
		iconTint="default"
	>
		<!-- Before the dot-matrix option, which overrides the times and format text -->
		<radio
			key="font"
			name="@string/opt_font"
			defaultValue="@style/Sparrow_Option_FontLook"
		>
			<option
				name="@string/opt_match_look"
				summary="@string/opt_match_look_summary"
				overlapStyle="@style/Sparrow_Option_FontLook"
			/>
			<option
				name="@string/opt_font_instrument_sans"
				summary="@string/opt_font_instrument_sans_summary"
				overlapStyle="@style/Sparrow_Option_FontInstrumentSans"
			/>
			<option
				name="@string/opt_font_plus_jakarta_sans"
				summary="@string/opt_font_plus_jakarta_sans_summary"
				overlapStyle="@style/Sparrow_Option_FontPlusJakartaSans"
			/>
			<option
				name="@string/opt_font_manrope"
				summary="@string/opt_font_manrope_summary"
				overlapStyle="@style/Sparrow_Option_FontManrope"
			/>
			<option
				name="@string/opt_font_inter"
				summary="@string/opt_font_inter_summary"
				overlapStyle="@style/Sparrow_Option_FontInter"
			/>
			<option
				name="@string/opt_font_system"
				summary="@string/opt_font_system_summary"
				overlapStyle="@style/Sparrow_Option_FontSystem"
			/>
		</radio>

		<multiSwitch
			key="dot_font"
			name="@string/opt_dot_font"
			summary="@string/opt_dot_font_summary"
			defaultValue=""
		>
			<option
				name="@string/opt_off"
				overlapStyle=""
			/>
			<option
				name="@string/opt_dot_details"
				overlapStyle="@style/Sparrow_Option_DotDetails"
			/>
			<option
				name="@string/opt_dot_details_line2"
				overlapStyle="@style/Sparrow_Option_DotDetailsAndLine2"
			/>
		</multiSwitch>
	</page>

	<page
		name="@string/page_lyrics"
		summary="@string/page_lyrics_summary"
		icon="@drawable/sparrow_page_lyrics"
		iconTint="default"
	>
		<radio
			key="lyrics_style"
			name="@string/opt_style"
			defaultValue="@style/Sparrow_Option_LyricsSpotlight"
		>
			<option
				name="@string/opt_lyrics_spotlight"
				summary="@string/opt_lyrics_spotlight_summary"
				overlapStyle="@style/Sparrow_Option_LyricsSpotlight"
				icon="@drawable/sparrow_opt_lyrics_spotlight"
			/>
			<option
				name="@string/opt_lyrics_centered"
				summary="@string/opt_lyrics_centered_summary"
				overlapStyle="@style/Sparrow_Option_LyricsCentered"
				icon="@drawable/sparrow_opt_lyrics_centered"
			/>
			<option
				name="@string/opt_lyrics_accent"
				summary="@string/opt_lyrics_accent_summary"
				overlapStyle="@style/Sparrow_Option_LyricsAccent"
				icon="@drawable/sparrow_opt_lyrics_accent"
			/>
			<option
				name="@string/opt_lyrics_calm"
				summary="@string/opt_lyrics_calm_summary"
				overlapStyle="@style/Sparrow_Option_LyricsCalm"
				icon="@drawable/sparrow_opt_lyrics_calm"
			/>
		</radio>
	</page>

	<!-- Poweramp saves options per skin entry, and every look is its own entry -->
	<msg
		line1="@string/msg_per_skin_title"
		smallLine1="@string/msg_per_skin"
	/>

</category>
