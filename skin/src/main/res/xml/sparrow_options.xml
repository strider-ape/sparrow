<?xml version="1.0" encoding="utf-8"?>
<!-- Options shared by the dark and light Sparrow skins (included from skins.xml).
     Most options switch on Poweramp's own overlay styles, so they stay correct across Poweramp updates.
     defaultValue holds the overlap value of the option that is on by default. -->
<category name="@string/opt_cat_player">

	<radio
		key="layout"
		name="@string/opt_layout"
		defaultValue="@com.maxmpz.audioplayer:attr/overlap_alt_layout"
	>
		<option
			name="@string/opt_layout_classic"
			summary="@string/opt_layout_classic_summary"
			overlapAttr=""
		/>
		<option
			name="@string/opt_layout_clean"
			summary="@string/opt_layout_clean_summary"
			overlapAttr="@com.maxmpz.audioplayer:attr/overlap_alt_layout"
		/>
		<option
			name="@string/opt_layout_full"
			summary="@string/opt_layout_full_summary"
			overlapAttr="@com.maxmpz.audioplayer:attr/overlap_alt_layout2"
		/>
	</radio>

	<multiSwitch
		key="track_labels_align"
		name="@string/opt_labels_align"
		defaultValue=""
	>
		<option
			name="@string/opt_left"
			overlapAttr=""
		/>
		<option
			name="@string/opt_centered"
			overlapAttr="@com.maxmpz.audioplayer:attr/overlap_track_labels_centered"
		/>
	</multiSwitch>

	<multiSwitch
		key="labels_bg"
		name="@string/opt_labels_bg"
		defaultValue="@com.maxmpz.audioplayer:attr/overlap_track_labels_no_bg"
	>
		<option
			name="@string/opt_shown"
			overlapAttr=""
		/>
		<option
			name="@string/opt_hidden"
			overlapAttr="@com.maxmpz.audioplayer:attr/overlap_track_labels_no_bg"
		/>
	</multiSwitch>

	<multiSwitch
		key="player_buttons_bg"
		name="@string/opt_buttons_bg"
		defaultValue="@com.maxmpz.audioplayer:attr/overlap_player_buttons_no_bg"
	>
		<option
			name="@string/opt_shown"
			overlapAttr=""
		/>
		<option
			name="@string/opt_hidden"
			overlapAttr="@com.maxmpz.audioplayer:attr/overlap_player_buttons_no_bg"
		/>
	</multiSwitch>

	<multiSwitch
		key="seekbar"
		name="@string/opt_seekbar"
		defaultValue="@com.maxmpz.audioplayer:attr/overlap_plain_seekbar"
	>
		<option
			name="@string/opt_seekbar_wave"
			overlapStyle=""
		/>
		<option
			name="@string/opt_seekbar_static"
			overlapStyle="@com.maxmpz.audioplayer:style/ActivityTheme_Whitepro_StaticSeekbar"
		/>
		<option
			name="@string/opt_seekbar_plain"
			overlapAttr="@com.maxmpz.audioplayer:attr/overlap_plain_seekbar"
		/>
	</multiSwitch>

	<!-- Declared after the seekbar option so it overrides the layout that option sets -->
	<multiSwitch
		key="seekbar_position"
		name="@string/opt_seekbar_position"
		summary="@string/opt_seekbar_position_summary"
		defaultValue="@style/Sparrow_Option_SeekbarTop"
	>
		<option
			name="@string/opt_bottom"
			overlapStyle=""
		/>
		<option
			name="@string/opt_under_track_info"
			overlapStyle="@style/Sparrow_Option_SeekbarTop"
		/>
	</multiSwitch>

	<multiSwitch
		key="time_bg"
		name="@string/opt_time_bg"
		summary="@string/opt_seekbar_position_summary"
		defaultValue="@style/Sparrow_Option_BareTimes"
	>
		<option
			name="@string/opt_shown"
			overlapStyle=""
		/>
		<option
			name="@string/opt_hidden"
			overlapStyle="@style/Sparrow_Option_BareTimes"
		/>
	</multiSwitch>

	<multiSwitch
		key="quick_buttons"
		name="@string/opt_quick_buttons"
		summary="@string/opt_quick_buttons_summary"
		defaultValue="@style/Sparrow_Option_NoQuickButtons"
	>
		<option
			name="@string/opt_shown"
			overlapStyle=""
		/>
		<option
			name="@string/opt_hidden"
			overlapStyle="@style/Sparrow_Option_NoQuickButtons"
		/>
	</multiSwitch>

	<multiSwitch
		key="volume_slider"
		name="@string/opt_volume_slider"
		defaultValue="@style/Sparrow_Option_Volume"
	>
		<option
			name="@string/opt_hidden"
			overlapStyle=""
		/>
		<option
			name="@string/opt_shown"
			overlapStyle="@style/Sparrow_Option_Volume"
		/>
	</multiSwitch>

	<multiSwitch
		key="control_size"
		name="@string/opt_control_size"
		summary="@string/opt_seekbar_position_summary"
		defaultValue="@style/Sparrow_Option_LargeControls"
	>
		<option
			name="@string/opt_normal"
			overlapStyle=""
		/>
		<option
			name="@string/opt_large"
			overlapStyle="@style/Sparrow_Option_LargeControls"
		/>
	</multiSwitch>

	<!-- Declared before the dot-matrix option, which overrides the times and format text -->
	<multiSwitch
		key="font"
		name="@string/opt_font"
		defaultValue="@style/Sparrow_Option_InterFont"
	>
		<option
			name="@string/opt_font_system"
			overlapStyle=""
		/>
		<option
			name="@string/opt_font_inter"
			overlapStyle="@style/Sparrow_Option_InterFont"
		/>
	</multiSwitch>

	<multiSwitch
		key="dot_font"
		name="@string/opt_dot_font"
		summary="@string/opt_dot_font_summary"
		defaultValue="@style/Sparrow_Option_DotDetails"
	>
		<option
			name="@string/opt_off"
			overlapStyle=""
		/>
		<option
			name="@string/opt_dot_details"
			overlapStyle="@style/Sparrow_Option_DotDetails"
		/>
		<option
			name="@string/opt_dot_details_line2"
			overlapStyle="@style/Sparrow_Option_DotDetailsAndLine2"
		/>
	</multiSwitch>

	<!-- Buttons over the cover. Declared after the layout option so it overrides the styles that option sets. -->
	<multiSwitch
		key="cover_buttons"
		name="@string/opt_cover_buttons"
		defaultValue="@style/Sparrow_Option_NoCoverButtons"
	>
		<option
			name="@string/opt_shown"
			overlapStyle=""
		/>
		<option
			name="@string/opt_hidden"
			overlapStyle="@style/Sparrow_Option_NoCoverButtons"
		/>
	</multiSwitch>

	<!-- Declared after "Buttons on cover" so it can bring the menu button back next to the title -->
	<multiSwitch
		key="more_button"
		name="@string/opt_more_button"
		summary="@string/opt_more_button_summary"
		defaultValue="@style/Sparrow_Option_MoreByTitle"
	>
		<option
			name="@string/opt_hidden"
			overlapStyle=""
		/>
		<option
			name="@string/opt_by_title"
			overlapStyle="@style/Sparrow_Option_MoreByTitle"
		/>
	</multiSwitch>

	<!-- Previous/next category buttons beside rewind/forward. Declared after the seekbar option so it overrides
	     the button styles that option sets. -->
	<multiSwitch
		key="category_buttons"
		name="@string/opt_category_buttons"
		defaultValue="@style/Sparrow_Option_NoCategoryButtons"
	>
		<option
			name="@string/opt_shown"
			overlapStyle=""
		/>
		<option
			name="@string/opt_hidden"
			overlapStyle="@style/Sparrow_Option_NoCategoryButtons"
		/>
	</multiSwitch>

</category>
