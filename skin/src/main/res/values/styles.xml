<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- Theme for the info screen only; the skin itself is in sparrow_styles.xml -->
	<style name="InfoTheme" parent="android:Theme.Material.NoActionBar">
		<item name="android:windowBackground">@color/info_bg</item>
		<item name="android:statusBarColor">@color/info_bg</item>
		<item name="android:navigationBarColor">@color/info_bg</item>
		<item name="android:colorAccent">@color/info_text</item>
	</style>

	<style name="InfoButton" parent="android:Widget.Material.Button">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">56dp</item>
		<!-- Margins, not root padding: fitsSystemWindows replaces the root's padding with insets -->
		<item name="android:layout_marginHorizontal">24dp</item>
		<item name="android:layout_marginBottom">12dp</item>
		<item name="android:textSize">16sp</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:stateListAnimator">@null</item>
	</style>
</resources>
