		<item name="com.maxmpz.audioplayer:ItemLyricsTitle_scene_small_active">@style/Sparrow_Lyrics_Centered_SmallActive</item>
		<item name="com.maxmpz.audioplayer:ItemLyricsTitle_scene_zoomed">@style/Sparrow_Lyrics_Centered_Zoomed</item>
