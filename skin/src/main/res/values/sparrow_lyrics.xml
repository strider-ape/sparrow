<?xml version="1.0" encoding="utf-8"?>
<!-- Lyrics styles (the Lyrics style option) and the lyrics background. Left-aligned styles use an 8sp margin: the row
     adds 16dp of padding, which lines the text up with the player's track info.
     Synced lyrics lines use ItemLyricsTitle (other lines) and ItemLyricsTitle_active (the current line), plus _scene_small
     and _scene_zoomed variants. Sparrow draws the other lines in the full text color and lets lyricsPrevAlpha /
     lyricsNextAlpha dim them (Poweramp uses a grey color on top of that). Unsynced lyrics keep Poweramp's styles. -->
<resources>

	<!-- Spotlight -->
	<style name="Sparrow_Lyrics_Spotlight_Text" parent="@com.maxmpz.audioplayer:style/ItemLyricsTitle_Text">
		<item name="android:textSize">26sp</item>
		<item name="android:fontFamily">?sparrowFont</item>
		<item name="android:textFontWeight">700</item>
		<item name="android:textStyle">bold</item>
	</style>
	<style name="Sparrow_Lyrics_Spotlight" parent="@com.maxmpz.audioplayer:style/ItemLyricsTitle">
		<item name="android:gravity">left</item>
		<item name="android:layout_gravity">left</item>
		<item name="android:layout_marginLeft">8sp</item>
		<item name="android:layout_marginRight">32sp</item>
		<item name="android:layout_marginTop">9sp</item>
		<item name="android:layout_marginBottom">9sp</item>
		<item name="android:textColor">?android:textColorPrimary</item>
	</style>
	<style name="Sparrow_Lyrics_Spotlight_Active" parent="@com.maxmpz.audioplayer:style/ItemLyricsTitle_active">
		<item name="android:gravity">left</item>
		<item name="android:layout_gravity">left|center_vertical</item>
		<item name="android:layout_marginLeft">8sp</item>
		<item name="android:layout_marginRight">32sp</item>
		<item name="android:layout_marginTop">9sp</item>
		<item name="android:layout_marginBottom">9sp</item>
		<item name="android:textColor">?android:textColorPrimary</item>
		<item name="com.maxmpz.audioplayer:scale">1</item>
		<item name="com.maxmpz.audioplayer:layout_compensateScale">1</item>
	</style>
	<style name="Sparrow_Lyrics_Spotlight_Small" parent="@com.maxmpz.audioplayer:style/ItemLyricsTitle_scene_small">
		<item name="android:gravity">left</item>
		<item name="android:layout_gravity">left</item>
		<item name="android:layout_marginLeft">8sp</item>
		<item name="android:layout_marginRight">32sp</item>
		<item name="android:textColor">?android:textColorPrimary</item>
	</style>
	<style name="Sparrow_Lyrics_Spotlight_SmallActive" parent="@com.maxmpz.audioplayer:style/ItemLyricsTitle_scene_small_active">
		<item name="android:gravity">left</item>
		<item name="android:layout_gravity">left|center_vertical</item>
		<item name="android:layout_marginLeft">8sp</item>
		<item name="android:layout_marginRight">32sp</item>
		<item name="android:textColor">?android:textColorPrimary</item>
		<item name="com.maxmpz.audioplayer:scale">0.65</item>
		<item name="com.maxmpz.audioplayer:layout_compensateScale">0.65</item>
	</style>
	<style name="Sparrow_Lyrics_Spotlight_Zoomed" parent="@com.maxmpz.audioplayer:style/ItemLyricsTitle_scene_zoomed">
		<item name="android:gravity">left</item>
		<item name="android:layout_gravity">left</item>
		<item name="android:layout_marginLeft">8sp</item>
		<item name="android:layout_marginRight">32sp</item>
		<item name="android:textColor">?android:textColorPrimary</item>
	</style>
	<style name="Sparrow_Lyrics_Spotlight_ZoomedActive" parent="@com.maxmpz.audioplayer:style/ItemLyricsTitle_scene_zoomed_active">
		<item name="android:gravity">left</item>
		<item name="android:layout_gravity">left|center_vertical</item>
		<item name="android:layout_marginLeft">8sp</item>
		<item name="android:layout_marginRight">32sp</item>
		<item name="android:textColor">?android:textColorPrimary</item>
		<item name="com.maxmpz.audioplayer:scale">1.2</item>
		<item name="com.maxmpz.audioplayer:layout_compensateScale">1.2</item>
	</style>
	<style name="Sparrow_Option_LyricsSpotlight">
		<item name="com.maxmpz.audioplayer:ItemLyricsTitle_Text">@style/Sparrow_Lyrics_Spotlight_Text</item>
		<item name="com.maxmpz.audioplayer:ItemLyricsTitle">@style/Sparrow_Lyrics_Spotlight</item>
		<item name="com.maxmpz.audioplayer:ItemLyricsTitle_active">@style/Sparrow_Lyrics_Spotlight_Active</item>
		<item name="com.maxmpz.audioplayer:ItemLyricsTitle_scene_small">@style/Sparrow_Lyrics_Spotlight_Small</item>
		<item name="com.maxmpz.audioplayer:ItemLyricsTitle_scene_small_active">@style/Sparrow_Lyrics_Spotlight_SmallActive</item>
		<item name="com.maxmpz.audioplayer:ItemLyricsTitle_scene_zoomed">@style/Sparrow_Lyrics_Spotlight_Zoomed</item>
		<item name="com.maxmpz.audioplayer:ItemLyricsTitle_scene_zoomed_active">@style/Sparrow_Lyrics_Spotlight_ZoomedActive</item>
		<item name="com.maxmpz.audioplayer:lyricsPrevAlpha">0.28</item>
		<item name="com.maxmpz.audioplayer:lyricsNextAlpha">0.38</item>
	</style>

