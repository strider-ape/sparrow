	<!-- Lyrics background (aaEffectReadable): a deep color from the cover instead of a busy blur, so lyrics always sit
	     on something calm. A positive aaBlurIntensity overrides the user's brightness for this background. -->
	<style name="Sparrow_LyricsEffect" parent="@com.maxmpz.audioplayer:style/ActivityTheme_Black_MilkViewEffect_Lyrics">
		<item name="com.maxmpz.audioplayer:aaSolidColorTarget">vibrant</item>
		<item name="com.maxmpz.audioplayer:aaBlurIntensity">0.4</item>
		<item name="com.maxmpz.audioplayer:aaBlurSaturation">1.2</item>
	</style>
	<!-- Onyx: black lyrics background -->
	<style name="Sparrow_Onyx_LyricsEffect" parent="@com.maxmpz.audioplayer:style/ActivityTheme_Black_MilkViewEffect_Lyrics">
		<item name="com.maxmpz.audioplayer:aaBlurDarken">0</item>
	</style>
</resources>
