<?xml version="1.0" encoding="utf-8"?>
<!-- Background option: a solid color picked from the cover instead of the blurred cover.
     The main screen background is Poweramp's TopMilk view. Setting aaSolidColorTarget makes it fill with one color
     from the cover's Android palette (falling back to colorAABgColor when the cover has none). Blur size and level are
     then ignored; the user's saturation and brightness settings still apply.
     Each choice points at a theme attribute, so the dark skin gets colors that keep white text readable and the light
     skin gets colors that keep dark text readable. -->
<resources>

	<!-- Base for every Sparrow background. The background is a SurfaceView that clears its area when drawn, so it must
	     draw before Sparrow's overlay (translationZ -4dp, see Sparrow_BgOverlay): views with lower Z draw first. -->
	<style name="Sparrow_Bg" parent="com.maxmpz.audioplayer:style/TopMilk">
		<item name="android:translationZ">-8dp</item>
		<item name="android:outlineProvider">none</item>
	</style>

	<style name="Sparrow_Option_BgColor">
		<item name="com.maxmpz.audioplayer:TopMilk">?attr/sparrowBgColor</item>
	</style>
	<style name="Sparrow_Option_BgVivid">
		<item name="com.maxmpz.audioplayer:TopMilk">?attr/sparrowBgVivid</item>
	</style>
	<style name="Sparrow_Option_BgMuted">
		<item name="com.maxmpz.audioplayer:TopMilk">?attr/sparrowBgMuted</item>
	</style>

	<!-- Dark skin. Vibrant and muted can be light on pale covers, so they are dimmed for white text: vibrant to 80%,
	     muted (usually lighter) to 70%, which kept a beige cover above 4.5:1 behind the artist line.
	     aaBlurIntensityMult keeps the hue; aaBlurDarken clamps channels and turns colors grey.

	     Cover color is vibrant at 60%, a deep version of the cover's main color. The palette's own darkVibrant was black
	     (missing) on 5 of 10 test covers, vibrant on 3 (only covers with no strong color). muted is never missing but
	     turns half the covers grey, and boosting its saturation made some neon. -->
	<style name="Sparrow_Bg_DeepVibrant" parent="Sparrow_Bg">
		<item name="com.maxmpz.audioplayer:aaSolidColorTarget">vibrant</item>
		<item name="com.maxmpz.audioplayer:aaBlurIntensityMult">0.6</item>
	</style>
	<style name="Sparrow_Bg_Vibrant" parent="Sparrow_Bg">
		<item name="com.maxmpz.audioplayer:aaSolidColorTarget">vibrant</item>
		<item name="com.maxmpz.audioplayer:aaBlurIntensityMult">0.8</item>
	</style>
	<!-- darkMuted is often missing on colorful covers (the background then falls back to black), so use muted -->
	<style name="Sparrow_Bg_Muted" parent="Sparrow_Bg">
		<item name="com.maxmpz.audioplayer:aaSolidColorTarget">muted</item>
		<item name="com.maxmpz.audioplayer:aaBlurIntensityMult">0.7</item>
	</style>

	<!-- Looks (values/sparrow_looks.xml) -->
	<!-- Poweramp's own blur, following the user's blur settings -->
	<style name="Sparrow_Bg_Blur" parent="Sparrow_Bg" />
	<!-- Base color for the Gradient look: a little brighter than Cover color, as the overlay darkens the bottom -->
	<style name="Sparrow_Bg_GradientBase" parent="Sparrow_Bg">
		<item name="com.maxmpz.audioplayer:aaSolidColorTarget">vibrant</item>
		<item name="com.maxmpz.audioplayer:aaBlurIntensityMult">0.75</item>
	</style>
	<!-- Pure black: any solid color at zero brightness -->
	<style name="Sparrow_Bg_Onyx" parent="Sparrow_Bg">
		<item name="com.maxmpz.audioplayer:aaSolidColorTarget">darkMuted</item>
		<item name="com.maxmpz.audioplayer:aaBlurIntensityMult">0</item>
		<item name="com.maxmpz.audioplayer:aaBgColor">#000</item>
	</style>
	<!-- Black list backgrounds for Onyx. aaBlurDarken clamps every channel, so 0 is black. -->
	<style name="Sparrow_Onyx_ListEffect" parent="com.maxmpz.audioplayer:style/ActivityTheme_Black_MilkViewEffect_List">
		<item name="com.maxmpz.audioplayer:aaBlurDarken">0</item>
	</style>

	<!-- Lists (aaEffectList): the same cover color as the player, as a calm wash behind the Library and song lists.
	     Poweramp's dark list effect blurs the cover and then clamps every channel at 17.5% (aaBlurPinLight .17,
	     aaBlurDarken .175), which leaves most covers near black. This keeps the hue and only dims it, so white text
	     stays readable. A positive aaBlurIntensity overrides the user's brightness for this background. -->
	<style name="Sparrow_ListEffect" parent="com.maxmpz.audioplayer:style/ActivityTheme_Black_MilkViewEffect_List">
		<item name="com.maxmpz.audioplayer:aaSolidColorTarget">vibrant</item>
		<item name="com.maxmpz.audioplayer:aaBlurIntensity">0.32</item>
		<item name="com.maxmpz.audioplayer:aaBlurSaturation">1.2</item>
		<item name="com.maxmpz.audioplayer:aaBlurPinLight">-1</item>
		<item name="com.maxmpz.audioplayer:aaBlurDarken">1</item>
	</style>

	<!-- Light skin -->
	<style name="Sparrow_Bg_LightVibrant" parent="Sparrow_Bg">
		<item name="com.maxmpz.audioplayer:aaSolidColorTarget">lightVibrant</item>
	</style>
	<style name="Sparrow_Bg_LightVibrantVivid" parent="Sparrow_Bg_LightVibrant">
		<item name="com.maxmpz.audioplayer:aaBlurSaturationMult">1.5</item>
	</style>
	<style name="Sparrow_Bg_LightMuted" parent="Sparrow_Bg">
		<item name="com.maxmpz.audioplayer:aaSolidColorTarget">lightMuted</item>
	</style>

</resources>
