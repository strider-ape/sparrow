<?xml version="1.0" encoding="utf-8"?>
<!-- Sparrow skin themes. Poweramp resources are referenced as com.maxmpz.audioplayer:...
     Every override derives from a Poweramp style so Poweramp updates don't break the skin. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ResourceCycle, NewApi">

	<!-- Main theme: dark, based on Poweramp's built-in dark theme.
	     Shared values are repeated in SparrowLight (styles can't have two parents). -->
	<style name="Sparrow" parent="com.maxmpz.audioplayer:style/ActivityTheme_Black">
		<!-- No tinted band under the transparent status bar -->
		<item name="com.maxmpz.audioplayer:statusBarBg">#0000</item>

		<!-- Large play/prev/next controls: bare white icons (circles come from the Button backgrounds option) -->
		<item name="com.maxmpz.audioplayer:colorPlayButtonsTint">#fff</item>
		<item name="com.maxmpz.audioplayer:main_play">@drawable/sparrow_play</item>
		<item name="com.maxmpz.audioplayer:pause_small_narrow">@drawable/sparrow_pause</item>
		<item name="com.maxmpz.audioplayer:main_pro_pause">@drawable/sparrow_pause</item>
		<item name="com.maxmpz.audioplayer:main_rw">@drawable/sparrow_rw</item>
		<item name="com.maxmpz.audioplayer:main_ff">@drawable/sparrow_ff</item>

		<!-- Plain seekbar: thin rounded track and a small round thumb -->
		<item name="com.maxmpz.audioplayer:PlainSeekbar">@style/Sparrow_PlainSeekbar_Wave</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarBg">#33ffffff</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarProgress">#e6ffffff</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarThumb">#fff</item>
		<!-- Nav bar: rounded outline icons; mini player seekbar matches the main one -->
		<item name="com.maxmpz.audioplayer:nav_lists">@com.maxmpz.audioplayer:drawable/lists_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:nav_equ">@com.maxmpz.audioplayer:drawable/equ_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:nav_search">@com.maxmpz.audioplayer:drawable/search_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:nav_hamburger">@com.maxmpz.audioplayer:drawable/hamburger_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:NavbarSeekbar">@style/Sparrow_NavbarSeekbar</item>
		<!-- Extra layout slot: optional volume slider, plus Poweramp's play counter when enabled -->
		<item name="com.maxmpz.audioplayer:TopContainer_extraLayout">@layout/sparrow_extralayout_includes</item>
		<item name="com.maxmpz.audioplayer:OptionCounter">@style/Sparrow_OptionCounter</item>
		<item name="sparrowCounterLayout">@null</item>
		<item name="sparrowVolumeLayout">@null</item>
		<item name="sparrowFont">@font/instrument_sans</item>
		<item name="sparrowVolumeSlider">@style/Sparrow_Volume_Minimal</item>
		<!-- Floating graphite nav bar with a hairline edge -->
		<item name="com.maxmpz.audioplayer:Navbar">@style/Sparrow_Navbar</item>
		<item name="com.maxmpz.audioplayer:colorBgNavbar">#2a2a2e</item>
		<item name="sparrowHairline">#1affffff</item>
		<item name="sparrowAccent">@color/sparrow_accent_dark</item>
		<item name="sparrowNavIconIdle">#999999</item>
		<item name="sparrowCatCircle">#1fffffff</item>
		<item name="sparrowCatIcon">#e6ffffff</item>
		<item name="sparrowGlassFill">@color/sparrow_glass_fill_dark</item>
		<item name="sparrowGlassRimTop">#33ffffff</item>
		<item name="sparrowGlassRimBottom">#1fffffff</item>
		<item name="sparrowNavPill">#1fffffff</item>
		<item name="sparrowBgColor">@style/Sparrow_Bg_DeepVibrant</item>
		<item name="sparrowBgVivid">@style/Sparrow_Bg_Vibrant</item>
		<item name="sparrowBgMuted">@style/Sparrow_Bg_Muted</item>
		<item name="sparrowBgOverlay">@null</item>
		<!-- Larger title and artist on the player screen (Poweramp: 16.5dp text at scale 1 on most phones) -->
		<item name="com.maxmpz.audioplayer:Alt_ItemTrackTitle_scene_aa_scale">1.4</item>
		<item name="com.maxmpz.audioplayer:Alt_ItemTrackLine2_scene_aa_scale">1.12</item>
		<item name="sparrowTopWaveseekLayout">@style/Sparrow_SeekbarTop_TopWaveseekLayout</item>
		<item name="sparrowTopPlay">@style/Sparrow_Large_TopPlay</item>
		<item name="sparrowTopPlayPlaying">@style/Sparrow_Large_TopPlay_scene_playing</item>
		<item name="sparrowTopPause">@style/Sparrow_Large_TopPause</item>
		<item name="sparrowTopPausePlaying">@style/Sparrow_Large_TopPause_scene_playing</item>
		<item name="sparrowTopRw">@style/Sparrow_Large_TopRw</item>
		<item name="sparrowTopRwPlaying">@style/Sparrow_Large_TopRw_scene_playing</item>
		<item name="sparrowTopFf">@style/Sparrow_Large_TopFf</item>
		<item name="sparrowTopFfPlaying">@style/Sparrow_Large_TopFf_scene_playing</item>
		<item name="sparrowTopTrackElapsed">@style/Sparrow_Bare_TopTrackElapsed</item>
		<item name="sparrowTopTrackDuration">@style/Sparrow_Bare_TopTrackDuration</item>
		<!-- Outlined buttons (list headers, back, more) get a soft hairline instead of a heavy grey ring -->
		<item name="com.maxmpz.audioplayer:colorStroke">#33ffffff</item>
		<item name="com.maxmpz.audioplayer:navbar_marginLR">16dp</item>
		<item name="com.maxmpz.audioplayer:navbar_marginB">12dp</item>

		<!-- Main screen cover, then list covers: soft squares for tracks and albums -->

		<item name="com.maxmpz.audioplayer:corners_aa_scene_aa">16dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_tracks">8dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_albums">8dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_tracks_grid">12dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_albums_grid">12dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_tracks_small">6dp</item>
		<item name="com.maxmpz.audioplayer:aaEffectReadable">@style/Sparrow_LyricsEffect</item>
	</style>

	<!-- Light variant, used when the system is in light mode -->
	<style name="SparrowLight" parent="com.maxmpz.audioplayer:style/ActivityTheme_White">
		<!-- Transparent status bar with dark icons -->
		<item name="com.maxmpz.audioplayer:statusBarBg">#0000</item>
		<item name="android:windowLightStatusBar">true</item>

		<!-- Large play/prev/next controls: bare dark icons (circles come from the Button backgrounds option) -->
		<item name="com.maxmpz.audioplayer:colorPlayButtonsTint">#111</item>
		<item name="com.maxmpz.audioplayer:main_play">@drawable/sparrow_play</item>
		<item name="com.maxmpz.audioplayer:pause_small_narrow">@drawable/sparrow_pause</item>
		<item name="com.maxmpz.audioplayer:main_pro_pause">@drawable/sparrow_pause</item>
		<item name="com.maxmpz.audioplayer:main_rw">@drawable/sparrow_rw</item>
		<item name="com.maxmpz.audioplayer:main_ff">@drawable/sparrow_ff</item>

		<item name="com.maxmpz.audioplayer:PlainSeekbar">@style/Sparrow_PlainSeekbar_Wave</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarBg">#26000000</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarProgress">#d9111111</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarThumb">#111</item>
		<!-- Nav bar: rounded outline icons; mini player seekbar matches the main one -->
		<item name="com.maxmpz.audioplayer:nav_lists">@com.maxmpz.audioplayer:drawable/lists_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:nav_equ">@com.maxmpz.audioplayer:drawable/equ_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:nav_search">@com.maxmpz.audioplayer:drawable/search_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:nav_hamburger">@com.maxmpz.audioplayer:drawable/hamburger_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:NavbarSeekbar">@style/Sparrow_NavbarSeekbar</item>
		<!-- Extra layout slot: optional volume slider, plus Poweramp's play counter when enabled -->
		<item name="com.maxmpz.audioplayer:TopContainer_extraLayout">@layout/sparrow_extralayout_includes</item>
		<item name="com.maxmpz.audioplayer:OptionCounter">@style/Sparrow_OptionCounter</item>
		<item name="sparrowCounterLayout">@null</item>
		<item name="sparrowVolumeLayout">@null</item>
		<item name="sparrowFont">@font/instrument_sans</item>
		<item name="sparrowVolumeSlider">@style/Sparrow_Volume_Minimal</item>
		<item name="com.maxmpz.audioplayer:Navbar">@style/Sparrow_Navbar</item>
		<item name="com.maxmpz.audioplayer:colorBgNavbar">#f4f4f6</item>
		<item name="sparrowHairline">#14000000</item>
		<item name="sparrowAccent">@color/sparrow_accent_light</item>
		<item name="sparrowNavIconIdle">#ff333333</item>
		<item name="sparrowCatCircle">#14000000</item>
		<item name="sparrowCatIcon">#ff222222</item>
		<item name="sparrowGlassFill">@color/sparrow_glass_fill_light</item>
		<item name="sparrowGlassRimTop">#1f000000</item>
		<item name="sparrowGlassRimBottom">#99ffffff</item>
		<item name="sparrowNavPill">#14000000</item>
		<item name="sparrowBgColor">@style/Sparrow_Bg_LightVibrant</item>
		<item name="sparrowBgVivid">@style/Sparrow_Bg_LightVibrantVivid</item>
		<item name="sparrowBgMuted">@style/Sparrow_Bg_LightMuted</item>
		<!-- Counter Poweramp's dark bottom fade so dark controls stay readable -->
		<item name="sparrowBgOverlay">@layout/merge_sparrow_bg_overlay</item>
		<!-- Larger title and artist on the player screen (Poweramp: 16.5dp text at scale 1 on most phones) -->
		<item name="com.maxmpz.audioplayer:Alt_ItemTrackTitle_scene_aa_scale">1.4</item>
		<item name="com.maxmpz.audioplayer:Alt_ItemTrackLine2_scene_aa_scale">1.12</item>
		<item name="sparrowBgOverlayDrawable">@drawable/sparrow_bg_light_fade</item>
		<item name="sparrowTopWaveseekLayout">@style/Sparrow_SeekbarTop_TopWaveseekLayout</item>
		<item name="sparrowTopPlay">@style/Sparrow_Large_TopPlay</item>
		<item name="sparrowTopPlayPlaying">@style/Sparrow_Large_TopPlay_scene_playing</item>
		<item name="sparrowTopPause">@style/Sparrow_Large_TopPause</item>
		<item name="sparrowTopPausePlaying">@style/Sparrow_Large_TopPause_scene_playing</item>
		<item name="sparrowTopRw">@style/Sparrow_Large_TopRw</item>
		<item name="sparrowTopRwPlaying">@style/Sparrow_Large_TopRw_scene_playing</item>
		<item name="sparrowTopFf">@style/Sparrow_Large_TopFf</item>
		<item name="sparrowTopFfPlaying">@style/Sparrow_Large_TopFf_scene_playing</item>
		<item name="sparrowTopTrackElapsed">@style/Sparrow_Bare_TopTrackElapsed</item>
		<item name="sparrowTopTrackDuration">@style/Sparrow_Bare_TopTrackDuration</item>
		<item name="com.maxmpz.audioplayer:colorStroke">#26000000</item>
		<item name="com.maxmpz.audioplayer:navbar_marginLR">16dp</item>
		<item name="com.maxmpz.audioplayer:navbar_marginB">12dp</item>


		<item name="com.maxmpz.audioplayer:corners_aa_scene_aa">16dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_tracks">8dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_albums">8dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_tracks_grid">12dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_albums_grid">12dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_tracks_small">6dp</item>
	</style>

	<style name="Sparrow_Navbar" parent="com.maxmpz.audioplayer:style/Navbar">
		<item name="android:background">@drawable/sparrow_navbar_bg</item>
	</style>

	<style name="Sparrow_NavbarSeekbar" parent="com.maxmpz.audioplayer:style/NavbarSeekbar">
		<item name="android:progressDrawable">@drawable/sparrow_seekbar</item>
		<item name="android:thumb">@drawable/sparrow_seekbar_thumb</item>
	</style>

	<!-- Progress bar styles (the Progress bar option). Line is the original thin line. -->
	<style name="Sparrow_PlainSeekbar" parent="com.maxmpz.audioplayer:style/PlainSeekbar">
		<item name="android:progressDrawable">@drawable/sparrow_seekbar</item>
		<item name="android:thumb">@drawable/sparrow_seekbar_thumb</item>
		<item name="android:splitTrack">false</item>
		<!-- No grey pressed band behind the bar (Poweramp's ripple_seekbar_bg): the thumbs react to touch instead -->
		<item name="android:background">@null</item>
	</style>
	<!-- The thumb is hidden until touched, so no split (it would leave a gap at the end of the fill) -->
	<style name="Sparrow_PlainSeekbar_Pill" parent="Sparrow_PlainSeekbar">
		<item name="android:progressDrawable">@drawable/sparrow_seekbar_pill</item>
		<item name="android:thumb">@drawable/sparrow_seekbar_pill_thumb</item>
	</style>
	<!-- splitTrack cuts the track around the handle's 16dp box -->
	<style name="Sparrow_PlainSeekbar_Expressive" parent="Sparrow_PlainSeekbar">
		<item name="android:progressDrawable">@drawable/sparrow_seekbar_expressive</item>
		<item name="android:thumb">@drawable/sparrow_seekbar_expressive_thumb</item>
		<item name="android:splitTrack">true</item>
	</style>
	<style name="Sparrow_PlainSeekbar_Glow" parent="Sparrow_PlainSeekbar">
		<item name="android:progressDrawable">@drawable/sparrow_seekbar_glow</item>
		<item name="android:thumb">@drawable/sparrow_seekbar_glow_thumb</item>
	</style>
	<!-- splitTrack leaves a small gap around the bar thumb -->
	<style name="Sparrow_PlainSeekbar_Wave" parent="Sparrow_PlainSeekbar">
		<item name="android:progressDrawable">@drawable/sparrow_seekbar_wave</item>
		<item name="android:thumb">@drawable/sparrow_seekbar_wave_thumb</item>
		<item name="android:splitTrack">true</item>
	</style>

</resources>
