<?xml version="1.0" encoding="utf-8"?>
<!-- Sparrow skin themes. Poweramp resources are referenced as com.maxmpz.audioplayer:...
     Every override derives from a Poweramp style so Poweramp updates don't break the skin. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ResourceCycle, NewApi">

	<!-- Main theme: dark, based on Poweramp's built-in dark theme.
	     Shared values are repeated in SparrowLight (styles can't have two parents). -->
	<style name="Sparrow" parent="com.maxmpz.audioplayer:style/ActivityTheme_Black">
		<!-- No tinted band under the transparent status bar -->
		<item name="com.maxmpz.audioplayer:statusBarBg">#0000</item>

		<!-- Large play/prev/next controls: bare white icons, no circles -->
		<item name="com.maxmpz.audioplayer:colorPlayButtonsBg">#0000</item>
		<item name="com.maxmpz.audioplayer:colorPlayButtonsStroke">#0000</item>
		<item name="com.maxmpz.audioplayer:colorPlayButtonsTint">#fff</item>
		<item name="com.maxmpz.audioplayer:main_play">@drawable/sparrow_play</item>
		<item name="com.maxmpz.audioplayer:pause_small_narrow">@drawable/sparrow_pause</item>
		<item name="com.maxmpz.audioplayer:main_pro_pause">@drawable/sparrow_pause</item>
		<item name="com.maxmpz.audioplayer:main_rw">@drawable/sparrow_rw</item>
		<item name="com.maxmpz.audioplayer:main_ff">@drawable/sparrow_ff</item>

		<!-- Plain seekbar: thin rounded track and a small round thumb -->
		<item name="com.maxmpz.audioplayer:PlainSeekbar">@style/Sparrow_PlainSeekbar</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarBg">#33ffffff</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarProgress">#e6ffffff</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarThumb">#fff</item>
		<!-- Nav bar: rounded outline icons; mini player seekbar matches the main one -->
		<item name="com.maxmpz.audioplayer:nav_lists">@com.maxmpz.audioplayer:drawable/lists_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:nav_equ">@com.maxmpz.audioplayer:drawable/equ_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:nav_search">@com.maxmpz.audioplayer:drawable/search_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:nav_hamburger">@com.maxmpz.audioplayer:drawable/hamburger_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:NavbarSeekbar">@style/Sparrow_NavbarSeekbar</item>
		<!-- Extra layout slot: optional volume slider, plus Poweramp's play counter when enabled -->
		<item name="com.maxmpz.audioplayer:TopContainer_extraLayout">@layout/sparrow_extralayout_includes</item>
		<item name="com.maxmpz.audioplayer:OptionCounter">@style/Sparrow_OptionCounter</item>
		<item name="sparrowCounterLayout">@null</item>
		<item name="sparrowVolumeLayout">@null</item>
		<!-- Floating graphite nav bar with a hairline edge -->
		<item name="com.maxmpz.audioplayer:Navbar">@style/Sparrow_Navbar</item>
		<item name="com.maxmpz.audioplayer:colorBgNavbar">#2a2a2e</item>
		<item name="sparrowHairline">#1affffff</item>
		<!-- Outlined buttons (list headers, back, more) get a soft hairline instead of a heavy grey ring -->
		<item name="com.maxmpz.audioplayer:colorStroke">#33ffffff</item>
		<item name="com.maxmpz.audioplayer:navbar_marginLR">16dp</item>
		<item name="com.maxmpz.audioplayer:navbar_marginB">12dp</item>

		<!-- Main screen cover, then list covers: soft squares for tracks and albums -->

		<item name="com.maxmpz.audioplayer:corners_aa_scene_aa">16dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_tracks">8dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_albums">8dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_tracks_grid">12dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_albums_grid">12dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_tracks_small">6dp</item>
	</style>

	<!-- Light variant, used when the system is in light mode -->
	<style name="SparrowLight" parent="com.maxmpz.audioplayer:style/ActivityTheme_White">
		<!-- Transparent status bar with dark icons -->
		<item name="com.maxmpz.audioplayer:statusBarBg">#0000</item>
		<item name="android:windowLightStatusBar">true</item>

		<!-- Large play/prev/next controls: bare dark icons, no circles -->
		<item name="com.maxmpz.audioplayer:colorPlayButtonsBg">#0000</item>
		<item name="com.maxmpz.audioplayer:colorPlayButtonsStroke">#0000</item>
		<item name="com.maxmpz.audioplayer:colorPlayButtonsTint">#111</item>
		<item name="com.maxmpz.audioplayer:main_play">@drawable/sparrow_play</item>
		<item name="com.maxmpz.audioplayer:pause_small_narrow">@drawable/sparrow_pause</item>
		<item name="com.maxmpz.audioplayer:main_pro_pause">@drawable/sparrow_pause</item>
		<item name="com.maxmpz.audioplayer:main_rw">@drawable/sparrow_rw</item>
		<item name="com.maxmpz.audioplayer:main_ff">@drawable/sparrow_ff</item>

		<item name="com.maxmpz.audioplayer:PlainSeekbar">@style/Sparrow_PlainSeekbar</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarBg">#26000000</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarProgress">#d9111111</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarThumb">#111</item>
		<!-- Nav bar: rounded outline icons; mini player seekbar matches the main one -->
		<item name="com.maxmpz.audioplayer:nav_lists">@com.maxmpz.audioplayer:drawable/lists_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:nav_equ">@com.maxmpz.audioplayer:drawable/equ_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:nav_search">@com.maxmpz.audioplayer:drawable/search_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:nav_hamburger">@com.maxmpz.audioplayer:drawable/hamburger_rounded_stroke_selector</item>
		<item name="com.maxmpz.audioplayer:NavbarSeekbar">@style/Sparrow_NavbarSeekbar</item>
		<!-- Extra layout slot: optional volume slider, plus Poweramp's play counter when enabled -->
		<item name="com.maxmpz.audioplayer:TopContainer_extraLayout">@layout/sparrow_extralayout_includes</item>
		<item name="com.maxmpz.audioplayer:OptionCounter">@style/Sparrow_OptionCounter</item>
		<item name="sparrowCounterLayout">@null</item>
		<item name="sparrowVolumeLayout">@null</item>
		<item name="com.maxmpz.audioplayer:Navbar">@style/Sparrow_Navbar</item>
		<item name="com.maxmpz.audioplayer:colorBgNavbar">#f4f4f6</item>
		<item name="sparrowHairline">#14000000</item>
		<item name="com.maxmpz.audioplayer:colorStroke">#26000000</item>
		<item name="com.maxmpz.audioplayer:navbar_marginLR">16dp</item>
		<item name="com.maxmpz.audioplayer:navbar_marginB">12dp</item>


		<item name="com.maxmpz.audioplayer:corners_aa_scene_aa">16dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_tracks">8dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_albums">8dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_tracks_grid">12dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_albums_grid">12dp</item>
		<item name="com.maxmpz.audioplayer:corners_aa_tracks_small">6dp</item>
	</style>

	<style name="Sparrow_Navbar" parent="com.maxmpz.audioplayer:style/Navbar">
		<item name="android:background">@drawable/sparrow_navbar_bg</item>
	</style>

	<style name="Sparrow_NavbarSeekbar" parent="com.maxmpz.audioplayer:style/NavbarSeekbar">
		<item name="android:progressDrawable">@drawable/sparrow_seekbar</item>
		<item name="android:thumb">@drawable/sparrow_seekbar_thumb</item>
	</style>

	<style name="Sparrow_PlainSeekbar" parent="com.maxmpz.audioplayer:style/PlainSeekbar">
		<item name="android:progressDrawable">@drawable/sparrow_seekbar</item>
		<item name="android:thumb">@drawable/sparrow_seekbar_thumb</item>
	</style>

</resources>
