<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay styles applied by Sparrow's own skin options (see xml/sparrow_options.xml) -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ResourceCycle, NewApi">

	<!-- Hides the like/dislike (or stars), lyrics and menu buttons drawn over the main screen cover -->
	<style name="Sparrow_Option_NoCoverButtons">
		<item name="com.maxmpz.audioplayer:ItemTrackMenu_scene_aa_visibility">gone</item>
		<item name="com.maxmpz.audioplayer:ItemTrackLyrics_scene_aa_visibility">gone</item>
		<item name="com.maxmpz.audioplayer:ItemLikeUnlikeLayout_scene_aa">@com.maxmpz.audioplayer:style/ItemLikeUnlikeLayout_scenes_invisible</item>
		<item name="com.maxmpz.audioplayer:ItemRatingBar_scene_aa">@com.maxmpz.audioplayer:style/ItemRatingBar_scene_aa_menu</item>
	</style>

	<!-- Dot-matrix font for the times and the format line -->
	<style name="Sparrow_Option_DotDetails">
		<item name="com.maxmpz.audioplayer:TopTrackElapsedDuration_Text">@style/Sparrow_Dot_TopTrackElapsedDuration_Text</item>
		<item name="com.maxmpz.audioplayer:TopMetaInfoLabel_Text">@style/Sparrow_Dot_TopMetaInfoLabel_Text</item>
	</style>

	<!-- Same, plus the artist/album line on the main screen and in lists -->
	<style name="Sparrow_Option_DotDetailsAndLine2" parent="Sparrow_Option_DotDetails">
		<item name="com.maxmpz.audioplayer:ItemTrackLine2_Text">@style/Sparrow_Dot_ItemTrackLine2_Text</item>
	</style>

	<style name="Sparrow_Dot_TopTrackElapsedDuration_Text" parent="com.maxmpz.audioplayer:style/TopTrackElapsedDuration_Text">
		<item name="android:fontFamily">@font/doto</item>
		<item name="android:textStyle">bold</item>
		<item name="android:textSize">15dp</item>
		<item name="android:letterSpacing">0.06</item>
	</style>

	<style name="Sparrow_Dot_TopMetaInfoLabel_Text" parent="com.maxmpz.audioplayer:style/TopMetaInfoLabel_Text">
		<item name="android:fontFamily">@font/doto</item>
		<item name="android:textStyle">bold</item>
		<item name="android:letterSpacing">0.08</item>
	</style>

	<style name="Sparrow_Dot_ItemTrackLine2_Text" parent="com.maxmpz.audioplayer:style/ItemTrackLine2_Text">
		<item name="android:fontFamily">@font/doto</item>
		<item name="android:textStyle">bold</item>
		<item name="android:letterSpacing">0.04</item>
	</style>

	<!-- Plain seekbar group right under the track info, big controls below it.
	     Poweramp keeps the seekbar at the bottom of the controls area and centers the play buttons in it,
	     so bottom padding lifts the seekbar and a negative offset moves the buttons down past it. -->
	<style name="Sparrow_Option_SeekbarTop">
		<item name="com.maxmpz.audioplayer:TopWaveseekLayout">@style/Sparrow_SeekbarTop_TopWaveseekLayout</item>
		<item name="com.maxmpz.audioplayer:PlainSeekbar_buttons_offset">-120dp</item>
	</style>

	<style name="Sparrow_SeekbarTop_TopWaveseekLayout" parent="com.maxmpz.audioplayer:style/PlainSeekbar_TopWaveseekLayout">
		<item name="android:paddingBottom">282dp</item>
	</style>

	<!-- Large play/pause and skip buttons. Based on the Clean layout + Plain seekbar button styles,
	     including the playing-scene variants so the size doesn't jump when playback starts. -->
	<style name="Sparrow_Option_LargeControls">
		<item name="com.maxmpz.audioplayer:TopPlay">@style/Sparrow_Large_TopPlay</item>
		<item name="com.maxmpz.audioplayer:TopPlay_scene_playing">@style/Sparrow_Large_TopPlay_scene_playing</item>
		<item name="com.maxmpz.audioplayer:TopPause">@style/Sparrow_Large_TopPause</item>
		<item name="com.maxmpz.audioplayer:TopPause_scene_playing">@style/Sparrow_Large_TopPause_scene_playing</item>
		<item name="com.maxmpz.audioplayer:TopRw">@style/Sparrow_Large_TopRw</item>
		<item name="com.maxmpz.audioplayer:TopRw_scene_playing">@style/Sparrow_Large_TopRw_scene_playing</item>
		<item name="com.maxmpz.audioplayer:TopFf">@style/Sparrow_Large_TopFf</item>
		<item name="com.maxmpz.audioplayer:TopFf_scene_playing">@style/Sparrow_Large_TopFf_scene_playing</item>
	</style>

	<style name="Sparrow_Large_TopPlay" parent="com.maxmpz.audioplayer:style/PlainSeekbar_Alt_TopPlay">
		<item name="com.maxmpz.audioplayer:layout_maxWidth">88dp</item>
		<item name="com.maxmpz.audioplayer:layout_maxHeight">88dp</item>
		<item name="android:layout_height">88dp</item>
	</style>
	<style name="Sparrow_Large_TopPlay_scene_playing" parent="com.maxmpz.audioplayer:style/PlainSeekbar_Alt_TopPlay_scene_playing">
		<item name="com.maxmpz.audioplayer:layout_maxWidth">88dp</item>
		<item name="com.maxmpz.audioplayer:layout_maxHeight">88dp</item>
		<item name="android:layout_height">88dp</item>
	</style>
	<style name="Sparrow_Large_TopPause" parent="com.maxmpz.audioplayer:style/PlainSeekbar_Alt_TopPauseMoreButtons">
		<item name="com.maxmpz.audioplayer:layout_maxWidth">88dp</item>
		<item name="com.maxmpz.audioplayer:layout_maxHeight">88dp</item>
		<item name="android:layout_height">88dp</item>
	</style>
	<style name="Sparrow_Large_TopPause_scene_playing" parent="com.maxmpz.audioplayer:style/PlainSeekbar_Alt_TopPauseMoreButtons_scene_playing">
		<item name="com.maxmpz.audioplayer:layout_maxWidth">80dp</item>
		<item name="com.maxmpz.audioplayer:layout_maxHeight">80dp</item>
		<item name="android:layout_height">80dp</item>
	</style>
	<style name="Sparrow_Large_TopRw" parent="com.maxmpz.audioplayer:style/PlainSeekbar_Alt_TopRw">
		<item name="com.maxmpz.audioplayer:layout_maxWidth">72dp</item>
		<item name="com.maxmpz.audioplayer:layout_maxHeight">72dp</item>
		<item name="android:layout_height">72dp</item>
		<item name="android:layout_marginRight">20dp</item>
	</style>
	<style name="Sparrow_Large_TopRw_scene_playing" parent="com.maxmpz.audioplayer:style/PlainSeekbar_Alt_TopRw_scene_playing">
		<item name="com.maxmpz.audioplayer:layout_maxWidth">72dp</item>
		<item name="com.maxmpz.audioplayer:layout_maxHeight">72dp</item>
		<item name="android:layout_height">72dp</item>
		<item name="android:layout_marginRight">20dp</item>
	</style>
	<style name="Sparrow_Large_TopFf" parent="com.maxmpz.audioplayer:style/PlainSeekbar_Alt_TopFf">
		<item name="com.maxmpz.audioplayer:layout_maxWidth">72dp</item>
		<item name="com.maxmpz.audioplayer:layout_maxHeight">72dp</item>
		<item name="android:layout_height">72dp</item>
		<item name="android:layout_marginLeft">20dp</item>
	</style>
	<style name="Sparrow_Large_TopFf_scene_playing" parent="com.maxmpz.audioplayer:style/PlainSeekbar_Alt_TopFf_scene_playing">
		<item name="com.maxmpz.audioplayer:layout_maxWidth">72dp</item>
		<item name="com.maxmpz.audioplayer:layout_maxHeight">72dp</item>
		<item name="android:layout_height">72dp</item>
		<item name="android:layout_marginLeft">20dp</item>
	</style>

	<!-- Times without the pill backgrounds (Plain seekbar styles) -->
	<style name="Sparrow_Option_BareTimes">
		<item name="com.maxmpz.audioplayer:TopTrackElapsed">@style/Sparrow_Bare_TopTrackElapsed</item>
		<item name="com.maxmpz.audioplayer:TopTrackDuration">@style/Sparrow_Bare_TopTrackDuration</item>
	</style>

	<style name="Sparrow_Bare_TopTrackElapsed" parent="com.maxmpz.audioplayer:style/PlainSeekbar_TopTrackElapsedMoreButtons">
		<item name="android:background">@android:color/transparent</item>
	</style>

	<style name="Sparrow_Bare_TopTrackDuration" parent="com.maxmpz.audioplayer:style/PlainSeekbar_TopTrackDurationMoreButtons">
		<item name="android:background">@android:color/transparent</item>
	</style>


	<!-- Track menu as an outlined round button to the right of the title (Clean layout).
	     Re-shows the menu that "Buttons on cover" hides, and keeps long titles clear of it. -->
	<style name="Sparrow_Option_MoreByTitle">
		<item name="com.maxmpz.audioplayer:ItemTrackMenu_scene_aa_visibility">visible</item>
		<item name="com.maxmpz.audioplayer:ItemTrackMenu_scene_aa">@style/Sparrow_TitleMenu_scene_aa</item>
		<item name="com.maxmpz.audioplayer:ItemTrackTitle_scene_aa">@style/Sparrow_TitleWithMenu_scene_aa</item>
		<item name="com.maxmpz.audioplayer:ItemTrackLine2_scene_aa">@style/Sparrow_Line2WithMenu_scene_aa</item>
	</style>

	<style name="Sparrow_TitleMenu_scene_aa" parent="com.maxmpz.audioplayer:style/Alt_ItemTrackMenu_scene_aa">
		<item name="com.maxmpz.audioplayer:layout_attachBottomToBottom">@com.maxmpz.audioplayer:id/line2</item>
		<item name="com.maxmpz.audioplayer:layout_attachRight">parent</item>
		<item name="android:layout_marginRight">16dp</item>
		<item name="android:layout_marginBottom">-6dp</item>
		<item name="android:background">@drawable/sparrow_more_bg</item>
		<item name="android:drawable">@drawable/sparrow_ph_more</item>
		<item name="com.maxmpz.audioplayer:drawableTint">?com.maxmpz.audioplayer:attr/colorIconPrimary</item>
	</style>

	<style name="Sparrow_TitleWithMenu_scene_aa" parent="com.maxmpz.audioplayer:style/Alt_ItemTrackTitle_scene_aa">
		<item name="android:layout_marginRight">72dp</item>
	</style>

	<style name="Sparrow_Line2WithMenu_scene_aa" parent="com.maxmpz.audioplayer:style/Alt_ItemTrackLine2_scene_aa">
		<item name="android:layout_marginRight">72dp</item>
	</style>

	<!-- Hides the quick buttons row under the track info (visualizer, sleep timer, repeat, shuffle).
	     The playing scene forces the row visible, so it is pointed at Poweramp's own hidden scene too. -->
	<style name="Sparrow_Option_NoQuickButtons">
		<item name="com.maxmpz.audioplayer:TopSubAAButtons">@style/Sparrow_Hidden_TopSubAAButtons</item>
		<item name="com.maxmpz.audioplayer:TopSubAAButtons_scenes_playing">@com.maxmpz.audioplayer:style/TopSubAAButtons_scenes_hidden</item>
	</style>

	<style name="Sparrow_Hidden_TopSubAAButtons" parent="com.maxmpz.audioplayer:style/Alt_TopSubAAButtons">
		<item name="android:visibility">gone</item>
	</style>

	<!-- Accent color (wallpaper palette on Android 12+, see values-v31/colors.xml) on the seekbars,
	     the volume thumb and the active nav icon. Everything else stays neutral. -->
	<style name="Sparrow_Option_Accent">
		<item name="com.maxmpz.audioplayer:colorSeekbarProgress">?attr/sparrowAccent</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarThumb">?attr/sparrowAccent</item>
		<item name="com.maxmpz.audioplayer:colorNavbarIcons">@color/sparrow_navbar_icons</item>
	</style>

	<!-- Phosphor nav bar icons: outline when idle, filled for the active tab (drawable/sparrow_ph_*) -->
	<style name="Sparrow_Option_PhosphorIcons">
		<item name="com.maxmpz.audioplayer:nav_lists">@drawable/sparrow_ph_lists_selector</item>
		<item name="com.maxmpz.audioplayer:nav_equ">@drawable/sparrow_ph_equ_selector</item>
		<item name="com.maxmpz.audioplayer:nav_search">@drawable/sparrow_ph_search_selector</item>
		<item name="com.maxmpz.audioplayer:nav_hamburger">@drawable/sparrow_ph_hamburger_selector</item>

		<!-- Library categories: line icons in soft circles instead of Poweramp's colored circles -->
		<item name="com.maxmpz.audioplayer:all_songs">@drawable/sparrow_cat_music_note</item>
		<item name="com.maxmpz.audioplayer:folders">@drawable/sparrow_cat_folder</item>
		<item name="com.maxmpz.audioplayer:folders_hier">@drawable/sparrow_cat_tree_structure</item>
		<item name="com.maxmpz.audioplayer:albums">@drawable/sparrow_cat_vinyl_record</item>
		<item name="com.maxmpz.audioplayer:albums_by_artist">@drawable/sparrow_cat_vinyl_record</item>
		<item name="com.maxmpz.audioplayer:artists">@drawable/sparrow_cat_microphone_stage</item>
		<item name="com.maxmpz.audioplayer:album_artists">@drawable/sparrow_cat_microphone</item>
		<item name="com.maxmpz.audioplayer:composers">@drawable/sparrow_cat_music_notes</item>
		<item name="com.maxmpz.audioplayer:playlists">@drawable/sparrow_cat_playlist</item>
		<item name="com.maxmpz.audioplayer:genres">@drawable/sparrow_cat_guitar</item>
		<item name="com.maxmpz.audioplayer:years">@drawable/sparrow_cat_calendar_blank</item>
		<item name="com.maxmpz.audioplayer:queue">@drawable/sparrow_cat_queue</item>
		<item name="com.maxmpz.audioplayer:top_rated">@drawable/sparrow_cat_star</item>
		<item name="com.maxmpz.audioplayer:low_rated">@drawable/sparrow_cat_thumbs_down</item>
		<item name="com.maxmpz.audioplayer:most_played">@drawable/sparrow_cat_fire</item>
		<item name="com.maxmpz.audioplayer:recently_played">@drawable/sparrow_cat_clock_counter_clockwise</item>
		<item name="com.maxmpz.audioplayer:recently_added">@drawable/sparrow_cat_sparkle</item>
		<item name="com.maxmpz.audioplayer:long_files">@drawable/sparrow_cat_hourglass</item>
		<item name="com.maxmpz.audioplayer:streams">@drawable/sparrow_cat_broadcast</item>
		<item name="com.maxmpz.audioplayer:bookmarks">@drawable/sparrow_cat_bookmark_simple</item>
		<item name="com.maxmpz.audioplayer:raw_file">@drawable/sparrow_cat_file_audio</item>
	</style>

	<!-- Glass nav bar: translucent with a light rim, a pill behind the active tab, and compact (floating, narrower)
	     on the player screen. List screens keep the full width because the mini player lives inside the bar there:
	     their scene styles use navbar_marginLR, while the player screen uses this base style's margins. -->
	<style name="Sparrow_Option_GlassNavbar">
		<item name="com.maxmpz.audioplayer:Navbar">@style/Sparrow_GlassNavbar</item>
		<item name="com.maxmpz.audioplayer:NavBarButton">@style/Sparrow_NavBarButton</item>
		<item name="com.maxmpz.audioplayer:navbar_elevation">0dp</item>
	</style>

	<style name="Sparrow_GlassNavbar" parent="com.maxmpz.audioplayer:style/Navbar">
		<item name="android:background">@drawable/sparrow_navbar_glass</item>
		<item name="android:layout_marginLeft">56dp</item>
		<item name="android:layout_marginRight">56dp</item>
	</style>

	<style name="Sparrow_NavBarButton" parent="com.maxmpz.audioplayer:style/NavBarButton">
		<item name="android:background">@drawable/sparrow_nav_button_bg</item>
	</style>

	<!-- Volume slider above the nav bar (layout/merge_sparrow_volume.xml) -->
	<style name="Sparrow_Option_Volume">
		<item name="sparrowVolumeLayout">@layout/merge_sparrow_volume</item>
	</style>

	<!-- Re-adds Poweramp's play counter (a Poweramp setting) into Sparrow's extra layout slot,
	     since Sparrow takes over TopContainer_extraLayout -->
	<style name="Sparrow_OptionCounter">
		<item name="sparrowCounterLayout">@com.maxmpz.audioplayer:layout/merge_top_extralayout</item>
	</style>

	<style name="Sparrow_VolumeSlider" parent="com.maxmpz.audioplayer:style/EqPreampLinearKnob">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">40dp</item>
		<item name="android:orientation">horizontal</item>
		<item name="com.maxmpz.audioplayer:layout_attachTop">@null</item>
		<item name="com.maxmpz.audioplayer:layout_attachBottom">@com.maxmpz.audioplayer:id/navbar_bounds</item>
		<item name="android:layout_gravity">center_horizontal</item>
		<item name="android:layout_marginLeft">20dp</item>
		<item name="android:layout_marginRight">20dp</item>
		<item name="android:layout_marginTop">0dp</item>
		<item name="android:layout_marginBottom">40dp</item>

		<!-- Side paddings match the track insets in sparrow_volume_track, so the thumb stays on the track -->
		<item name="android:paddingLeft">36dp</item>
		<item name="android:paddingRight">36dp</item>
		<item name="android:paddingTop">0dp</item>
		<item name="android:paddingBottom">0dp</item>

		<item name="com.maxmpz.audioplayer:linesBackground">false</item>
		<item name="android:background">@drawable/sparrow_volume_track</item>
		<item name="com.maxmpz.audioplayer:thumb">@drawable/sparrow_volume_thumb</item>
		<item name="com.maxmpz.audioplayer:thumbWidth">18dp</item>
		<item name="com.maxmpz.audioplayer:thumbHeight">18dp</item>

		<!-- No label or value box: the speaker icons say what it is -->
		<item name="android:text">@null</item>
		<item name="com.maxmpz.audioplayer:labelBackground">@android:color/transparent</item>
		<item name="com.maxmpz.audioplayer:valueFormat">@null</item>
	</style>

	<style name="Sparrow_VolumeSliderHidden">
		<item name="com.maxmpz.audioplayer:scale">.7</item>
		<item name="android:visibility">invisible</item>
	</style>

	<!-- Hides the previous/next category buttons -->
	<style name="Sparrow_Option_NoCategoryButtons">
		<item name="com.maxmpz.audioplayer:TopPrevCat">@style/Sparrow_Hidden_TopPrevCat</item>
		<item name="com.maxmpz.audioplayer:TopNextCat">@style/Sparrow_Hidden_TopNextCat</item>
	</style>

	<style name="Sparrow_Hidden_TopPrevCat" parent="com.maxmpz.audioplayer:style/TopPrevCat">
		<item name="android:enabled">false</item>
		<item name="android:visibility">gone</item>
		<item name="com.maxmpz.audioplayer:applyScene">false</item>
	</style>

	<style name="Sparrow_Hidden_TopNextCat" parent="com.maxmpz.audioplayer:style/TopNextCat">
		<item name="android:enabled">false</item>
		<item name="android:visibility">gone</item>
		<item name="com.maxmpz.audioplayer:applyScene">false</item>
	</style>

</resources>
