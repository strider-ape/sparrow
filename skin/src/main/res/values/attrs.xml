<?xml version="1.0" encoding="utf-8"?>
<!-- Sparrow's own theme attributes, set per theme in sparrow_styles.xml -->
<resources>
	<!-- Hairline edge around floating surfaces such as the nav bar -->
	<attr name="sparrowHairline" format="color" />

	<!-- Accent used by the Accent option (seekbars, volume thumb, active nav icon), and the idle nav icon color -->
	<attr name="sparrowAccent" format="color" />
	<attr name="sparrowNavIconIdle" format="color" />

	<!-- Glass nav bar (drawable/sparrow_navbar_glass): translucent fill, light rim (top to bottom), active tab pill -->
	<attr name="sparrowGlassFill" format="color" />
	<attr name="sparrowGlassRimTop" format="color" />
	<attr name="sparrowGlassRimBottom" format="color" />
	<attr name="sparrowNavPill" format="color" />
	<!-- Glass nav bar icons (color/sparrow_glass_nav_icons): the current tab, and the others at 35%. Not Poweramp's
	     colorIconPrimary: its white theme leaves that @null, which a color list draws as magenta. -->
	<attr name="sparrowNavIconActive" format="color" />
	<!-- Glow behind the current nav tab (drawable/sparrow_nav_button_bg); transparent for none -->
	<attr name="sparrowNavGlow" format="color" />

	<!-- Font used by the Font option's text styles, the lyrics and the dot-matrix fallback: a @font resource or a family
	     name such as sans-serif -->
	<attr name="sparrowFont" format="reference|string" />
	<!-- Track title font (the Font option's title style). The base themes point it at ?sparrowFont; a look can give the
	     title its own face (Paper: a serif). -->
	<attr name="sparrowTitleFont" format="reference|string" />

	<!-- Library category icons (drawable/sparrow_cat_*): soft circle and line icon colors -->
	<attr name="sparrowCatCircle" format="color" />
	<attr name="sparrowCatIcon" format="color" />

	<!-- Background option: the main screen background style (TopMilk) for each color choice.
	     Dark themes point at dark palette colors (white text stays readable), light themes at light ones. -->
	<attr name="sparrowBgColor" format="reference" />
	<attr name="sparrowBgVivid" format="reference" />
	<attr name="sparrowBgMuted" format="reference" />
	<!-- Optional layout drawn over the background and under everything else on the player screen (looks use it for
	     gradients). @null means none. -->
	<attr name="sparrowBgOverlay" format="reference" />
	<attr name="sparrowBgOverlayDrawable" format="reference" />
	<!-- Cover option (values/sparrow_blended.xml): sparrowCoverStyle is the look's own choice ("Match the look"),
	     sparrowBlendedStyle the Blended style for this theme (an empty one where Blended doesn't apply) -->
	<attr name="sparrowCoverStyle" format="reference" />
	<attr name="sparrowBlendedStyle" format="reference" />

	<!-- Styles behind the Plain-seekbar-only options (Seekbar position, Control size, Time backgrounds). The base themes
	     point them at Sparrow's styles; the Wave and Static seekbar choices point them back at Poweramp's own, so those
	     options can't distort the wave seekbar. -->
	<attr name="sparrowTopWaveseekLayout" format="reference" />
	<attr name="sparrowTopPlay" format="reference" />
	<attr name="sparrowTopPlayPlaying" format="reference" />
	<attr name="sparrowTopPause" format="reference" />
	<attr name="sparrowTopPausePlaying" format="reference" />
	<attr name="sparrowTopRw" format="reference" />
	<attr name="sparrowTopRwPlaying" format="reference" />
	<attr name="sparrowTopFf" format="reference" />
	<attr name="sparrowTopFfPlaying" format="reference" />
	<attr name="sparrowTopTrackElapsed" format="reference" />
	<attr name="sparrowTopTrackDuration" format="reference" />

	<!-- Optional layouts included into Poweramp's TopContainer_extraLayout slot (see layout/sparrow_extralayout_includes.xml).
	     @null means nothing is included. -->
	<attr name="sparrowCounterLayout" format="reference" />
	<attr name="sparrowVolumeLayout" format="reference" />
	<!-- Style of the volume slider (the Volume style option) -->
	<attr name="sparrowVolumeSlider" format="reference" />
</resources>
