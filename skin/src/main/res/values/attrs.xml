<?xml version="1.0" encoding="utf-8"?>
<!-- Sparrow's own theme attributes, set per theme in sparrow_styles.xml -->
<resources>
	<!-- Hairline edge around floating surfaces such as the nav bar -->
	<attr name="sparrowHairline" format="color" />

	<!-- Accent used by the Accent option (seekbars, volume thumb, active nav icon), and the idle nav icon color -->
	<attr name="sparrowAccent" format="color" />
	<attr name="sparrowNavIconIdle" format="color" />

	<!-- Glass nav bar (drawable/sparrow_navbar_glass): translucent fill, light rim (top to bottom), active tab pill -->
	<attr name="sparrowGlassFill" format="color" />
	<attr name="sparrowGlassRimTop" format="color" />
	<attr name="sparrowGlassRimBottom" format="color" />
	<attr name="sparrowNavPill" format="color" />

	<!-- Library category icons (drawable/sparrow_cat_*): soft circle and line icon colors -->
	<attr name="sparrowCatCircle" format="color" />
	<attr name="sparrowCatIcon" format="color" />

	<!-- Background option: the main screen background style (TopMilk) for each color choice.
	     Dark themes point at dark palette colors (white text stays readable), light themes at light ones. -->
	<attr name="sparrowBgColor" format="reference" />
	<attr name="sparrowBgVivid" format="reference" />
	<attr name="sparrowBgMuted" format="reference" />

	<!-- Optional layouts included into Poweramp's TopContainer_extraLayout slot (see layout/sparrow_extralayout_includes.xml).
	     @null means nothing is included. -->
	<attr name="sparrowCounterLayout" format="reference" />
	<attr name="sparrowVolumeLayout" format="reference" />
</resources>
