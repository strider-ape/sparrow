<?xml version="1.0" encoding="utf-8"?>
<!-- Small round volume thumb, matching the seekbar thumb, centered in the 36dp thumb box (see Sparrow_Volume_Fill).
     Dimmed when the slider is disabled, which happens when Poweramp's Direct Volume Control is off. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:width="18dp" android:height="18dp" android:gravity="center">
		<selector android:enterFadeDuration="150" android:exitFadeDuration="150">
			<item android:state_enabled="false">
				<inset android:inset="4dp">
					<shape android:shape="oval">
						<solid android:color="?com.maxmpz.audioplayer:attr/colorSeekbarBg" />
						<stroke android:width="1.5dp" android:color="?com.maxmpz.audioplayer:attr/colorSeekbarThumb" />
					</shape>
				</inset>
			</item>
			<item android:state_pressed="true">
				<shape android:shape="oval">
					<solid android:color="?com.maxmpz.audioplayer:attr/colorSeekbarThumb" />
				</shape>
			</item>
			<item>
				<inset android:inset="3dp">
					<shape android:shape="oval">
						<solid android:color="?com.maxmpz.audioplayer:attr/colorSeekbarThumb" />
					</shape>
				</inset>
			</item>
		</selector>
	</item>
</layer-list>
