<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora look: the cover color with a light glow at the top, and two soft glows in the wallpaper's accent tones
     rising from the bottom corners, over a deepening toward the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item>
		<shape>
			<gradient
				android:type="radial"
				android:centerX="0.5"
				android:centerY="0"
				android:gradientRadius="110%"
				android:startColor="#38ffffff"
				android:centerColor="#0fffffff"
				android:endColor="#00ffffff" />
		</shape>
	</item>
	<item>
		<shape>
			<gradient
				android:angle="270"
				android:startColor="#00000000"
				android:centerColor="#26000000"
				android:endColor="#a6000000" />
		</shape>
	</item>
	<item>
		<shape>
			<gradient
				android:type="radial"
				android:centerX="0.05"
				android:centerY="1"
				android:gradientRadius="95%"
				android:startColor="@color/sparrow_aurora_1"
				android:endColor="#00000000" />
		</shape>
	</item>
	<item>
		<shape>
			<gradient
				android:type="radial"
				android:centerX="1"
				android:centerY="0.82"
				android:gradientRadius="75%"
				android:startColor="@color/sparrow_aurora_2"
				android:endColor="#00000000" />
		</shape>
	</item>
</layer-list>
