<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient look: turns the flat cover color into a gradient of the same hue.
     A soft light glow from the top center, then a deepening toward the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item>
		<shape>
			<gradient
				android:type="radial"
				android:centerX="0.5"
				android:centerY="0"
				android:gradientRadius="110%"
				android:startColor="#47ffffff"
				android:centerColor="#14ffffff"
				android:endColor="#00ffffff" />
		</shape>
	</item>
	<item>
		<shape>
			<gradient
				android:angle="270"
				android:startColor="#00000000"
				android:centerColor="#1a000000"
				android:endColor="#8c000000" />
		</shape>
	</item>
</layer-list>
