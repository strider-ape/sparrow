<?xml version="1.0" encoding="utf-8"?>
<!-- The knob's "hole" for Sparrow's volume styles. Poweramp positions the value fill with the hole's padding, and starts
     it at twice the view's side padding plus that padding; the -36dp insets cancel one of the two 36dp paddings, so the
     fill starts where the track does (see Sparrow_Volume_Fill). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
	android:insetLeft="-36dp"
	android:insetRight="-36dp"
	android:drawable="@android:color/transparent" />
