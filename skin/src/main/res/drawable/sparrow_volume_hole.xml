<?xml version="1.0" encoding="utf-8"?>
<!-- The knob's "hole" for Sparrow's fill volume styles. With a hole set, the knob places its value fill and thumb
     travel inside the view's padding twice, so those styles use 18dp side padding (36dp in total, matching the
     track's insets in the backgrounds) and this hole adds none. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
	android:inset="0dp"
	android:drawable="@android:color/transparent" />
