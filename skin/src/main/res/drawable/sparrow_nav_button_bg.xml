<?xml version="1.0" encoding="utf-8"?>
<!-- Nav bar button background, modelled on the Iconify app's floating bar:
     - the current tab gets a soft radial accent glow (Iconify draws a 60% accent circle blurred by 50dp)
     - touching blooms an unbounded white glow from the finger (no mask, so the ripple spreads past the button) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
	android:color="#73FFFFFF"
	android:radius="56dp">
	<item>
		<selector android:enterFadeDuration="250" android:exitFadeDuration="250">
			<item android:state_activated="true">
				<shape android:shape="oval">
					<gradient
						android:type="radial"
						android:gradientRadius="50%"
						android:centerX="0.5"
						android:centerY="0.5"
						android:startColor="@color/sparrow_accent_glow"
						android:endColor="#00000000" />
				</shape>
			</item>
			<item android:drawable="@android:color/transparent" />
		</selector>
	</item>
</ripple>
