<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal volume thumb: hidden, and a small dot while dragging -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="150" android:exitFadeDuration="150">
	<item android:state_pressed="true">
		<shape android:shape="oval"><solid android:color="?com.maxmpz.audioplayer:attr/colorSeekbarThumb" /></shape>
	</item>
	<item android:drawable="@android:color/transparent" />
</selector>
