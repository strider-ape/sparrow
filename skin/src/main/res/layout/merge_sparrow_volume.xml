<?xml version="1.0" encoding="utf-8"?>
<!-- Slim horizontal volume slider above the nav bar, controlling Poweramp's volume.
     Shown on the player screen only. Bound the same way as Poweramp's own volume knobs (volume_panel.xml):
     dspParamDef gives the real 0-100% range, enablingParam follows Poweramp's volume control setting. -->
<merge
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:w="http://schemas.android.com/apk/res/com.maxmpz.audioplayer">

	<com.maxmpz.widget.player.DSPLinearKnob
		android:id="@+id/sparrow_volume"
		style="@style/Sparrow_VolumeSlider"
		android:orientation="horizontal"
		android:contentDescription="@string/volume"
		w:param="@com.maxmpz.audioplayer:id/dsp_master_volume"
		w:updateMsgId="@com.maxmpz.audioplayer:id/msg_dsp_other_changed"
		w:dspParamDef="@com.maxmpz.audioplayer:id/dsp_master_volume"
		w:enablingParam="@com.maxmpz.audioplayer:id/dsp_master_volume_enabled"
		w:rounding="100.5"
		tools:ignore="MissingClass" />

	<!-- Visible while playing -->
	<SceneParams
		w:baseScene="defaultScene"
		w:scene="@com.maxmpz.audioplayer:id/scene_playing"
		android:visibility="visible"
		tools:ignore="MissingClass" />

	<!-- Hidden on the other screens -->
	<SceneParams
		style="@style/Sparrow_VolumeSliderHidden"
		w:scene="@com.maxmpz.audioplayer:id/scene_lib"
		w:scene_2="@com.maxmpz.audioplayer:id/scene_search"
		w:scene_3="@com.maxmpz.audioplayer:id/scene_eq"
		w:scene_4="@com.maxmpz.audioplayer:id/scene_vis_w_ui"
		w:scene_5="@com.maxmpz.audioplayer:id/scene_vis_temp_ui"
		w:scene_6="@com.maxmpz.audioplayer:id/scene_vis"
		android:visibility="invisible"
		tools:ignore="MissingClass" />
</merge>
