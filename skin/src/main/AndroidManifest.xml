<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- Package visibility (Android 11+): lets the info screen find and launch Poweramp -->
	<queries>
		<package android:name="com.maxmpz.audioplayer" />
	</queries>

	<application
		android:allowBackup="false"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:supportsRtl="true"
		android:theme="@style/InfoTheme">

		<!-- Tells Poweramp this APK provides skins -->
		<meta-data
			android:name="com.maxmpz.PowerampSkins"
			android:resource="@xml/skins" />

		<activity
			android:name=".SkinInfoActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
			<intent-filter>
				<!-- Lets Poweramp discover this skin app on Android 11+ -->
				<action android:name="com.maxmpz.audioplayer.SKIN_MAIN" />
			</intent-filter>
		</activity>
	</application>

</manifest>
